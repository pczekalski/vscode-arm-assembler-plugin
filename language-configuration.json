{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*[A-Za-z_.$][A-Za-z0-9_.$]*\\s*:\\s*(//.*|/\\*.*\\*/|@.*)?$",
        "decreaseIndentPattern": "^\\s*\\.(end|endm|endfunc|endr|endif)\\b"
    }
}
